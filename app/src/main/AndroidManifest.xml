<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：直播源/弹幕/同步（镜像原 app 的网络权限） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 日志抓取写共享存储（仅 Android 9- 需要；10+ 走 MediaStore 免权限） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 后台播放保活（镜像 Dart 版 manifest：mediaPlayback 前台服务三件套） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LiveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LiveApp">

        <!-- 单 Activity 宿主：旋转/深浅色切换不重建（直播间全屏切换与平板旋转依赖 configChanges，
             否则 NavHost 状态丢失；旋转后布局重算由 Compose LocalConfiguration 驱动）。
             方向策略（task 10-07-tablet-landscape-layout）：**不再硬锁竖屏**——平板需自由旋转
             才能进入横屏大屏布局；改由 MainActivity 按设备档位在运行时决定（平板释放全部方向、
             紧凑手机锁竖屏，见 ui/WideLayout.kt deviceOrientationPolicy）。
             uiMode：对齐 Dart 版 manifest——切系统深色不重建（否则每次切深色都重拉流
             重建 mpv 会话，且重建时序曾触发聊天列表 requestScrollToItem(-1) 崩溃）；
             深浅色即时切换由 Compose isSystemInDarkTheme 经 onConfigurationChanged 重组驱动） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台播放保活前台服务（对应 Dart 版同名服务；启停由 BackgroundPlayback
             按播放状态与 allowBackgroundPlayback 设置驱动，见 LiveRoomController） -->
        <service
            android:name=".service.BackgroundPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
