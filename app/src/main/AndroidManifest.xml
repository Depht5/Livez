<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：直播源/弹幕/同步（镜像原 app 的网络权限） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 日志抓取写共享存储（仅 Android 9- 需要；10+ 走 MediaStore 免权限） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".LiveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LiveApp">

        <!-- 单 Activity 宿主：竖屏 + 旋转不重建（直播间全屏切换依赖 configChanges，
             否则 NavHost 状态丢失；旋转后布局重算由 Compose LocalConfiguration 驱动） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LiveRoomActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:screenOrientation="portrait" />
    </application>

</manifest>
