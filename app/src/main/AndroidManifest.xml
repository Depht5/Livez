<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：直播源/弹幕/同步（镜像原 app 的网络权限） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 日志抓取写共享存储（仅 Android 9- 需要；10+ 走 MediaStore 免权限） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 后台播放保活（镜像 Dart 版 manifest：mediaPlayback 前台服务三件套） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新：下载完成后调起系统安装器（task 10-21-settings-about-update-check）。
         仅 APK 安装需要，不涉及其它用途；授权由系统「未知来源」流程二次确认 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 局域网同步扫码（task 10-24-lan-sync-ui）：扫对端「本机信息」二维码取地址；
         required=false —— 无相机设备仍可安装（手动输入地址兜底） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".LiveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LiveApp">

        <!-- 单 Activity 宿主：旋转/深浅色切换不重建（直播间全屏切换与平板旋转依赖 configChanges，
             否则 NavHost 状态丢失；旋转后布局重算由 Compose LocalConfiguration 驱动）。
             方向策略（task 10-07-tablet-landscape-layout）：**不再硬锁竖屏**——平板需自由旋转
             才能进入横屏大屏布局；改由 MainActivity 按设备档位在运行时决定（平板释放全部方向、
             紧凑手机锁竖屏，见 ui/WideLayout.kt deviceOrientationPolicy）。
             uiMode：对齐 Dart 版 manifest——切系统深色不重建（否则每次切深色都重拉流
             重建 mpv 会话，且重建时序曾触发聊天列表 requestScrollToItem(-1) 崩溃）；
             深浅色即时切换由 Compose isSystemInDarkTheme 经 onConfigurationChanged 重组驱动） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 局域网同步扫码页（task 10-24-lan-sync-ui）：zxing-android-embedded 的 CaptureActivity
             默认锁横屏，子类化并显式声明竖屏，与 App 其余页面方向一致 -->
        <activity
            android:name=".ui.PortraitCaptureActivity"
            android:screenOrientation="portrait" />

        <!-- 后台播放保活前台服务（对应 Dart 版同名服务；启停由 BackgroundPlayback
             按播放状态与 allowBackgroundPlayback 设置驱动，见 LiveRoomController） -->
        <service
            android:name=".service.BackgroundPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 应用内更新安装包共享：下载目录 filesDir/updates 通过 FileProvider 交给系统安装器
             （content:// 协议，无需暴露存储权限；task 10-21-settings-about-update-check） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
